# Copie este arquivo para .env (na mesma pasta) e preencha. O .env não vai para o Git.

# Deep Scan com IA (opcional): chave gratuita em https://aistudio.google.com/apikey
# Sem ela, o Deep Scan usa a análise local, que funciona offline.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Especialista de textura do Hugging Face (opcional, não medido nos testes do projeto). Sem esta linha, o sistema
# usa o classificador local (TrashNet, TrashBox e TACO: 92,1% nas fotos de estúdio, 89,9% nas variadas e 65% em
# recortes de lixo real).
# WASTE_HF_MODEL=watersplash/waste-classification

# Detector: coco (padrão, com o detector do TACO onde o COCO não acha nada), yolo-world ou yoloe
# WASTE_DETECTOR=coco
